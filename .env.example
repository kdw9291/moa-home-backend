# 자리표시자만 둔다. 실제 값은 비추적 파일 `.env`(gitignore)에만 넣는다.

# 공공데이터포털 청약홈 API 인증키. 포털이 URL 인코딩된 형태(% 포함)로 주면 그대로 넣어도 된다:
# 수집기가 params로 넘기기 전에 한 번만 디코딩한다(이중 인코딩 방지).
DATA_GO_KR_API_KEY=your-datagokr-key-here

# Supabase 프로젝트(서버 전용 Secret Key는 브라우저·로그·저장소 노출 금지)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# 수집기·알림 발송기가 직접 접속하는 PostgreSQL 접속 문자열(Supabase: Connect > Session pooler).
# 주의: 백엔드 DB 테스트에는 이 값을 쓰지 말고 로컬 Docker DB를 TEST_DATABASE_URL로 지정한다(테스트가 테이블을 지운다).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:5432/postgres

# Web Push(VAPID). 비공개 키는 백엔드 전용, 프런트에는 공개 키만 둔다.
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_SUBJECT=mailto:you@example.com
